{
  "name": "impro",
  "version": "0.1.0",
  "private": true,
  "description": "Impro — all your conversations, one place.",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "@nestjs/core",
      "msgpackr-extract"
    ]
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "seed": "pnpm --filter @impro/api seed",
    "db:migrate": "pnpm --filter @impro/api prisma:migrate"
  }
}
