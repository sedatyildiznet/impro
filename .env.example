# =============================================================================
# Impro — environment template
# Copy to .env and fill in secrets. Never commit a real .env.
# Generate secrets with: ./scripts/bootstrap.sh
# =============================================================================

# --- Public domains ---
# impro.chat              landing + Matrix well-known (server_name)
# app.impro.chat          web client / login
# api.impro.chat          Impro API
# matrix.impro.chat       Synapse client/federation endpoint
# auth.impro.chat         MAS (branded as Impro auth)
# Matrix IDs stay @username:impro.chat  — never @username:app.impro.chat
DOMAIN=impro.chat
APP_HOST=app.impro.chat
SCHEME=https
SITE_URL=https://impro.chat
APP_URL=https://app.impro.chat
API_URL=https://api.impro.chat
MATRIX_PUBLIC_URL=https://matrix.impro.chat
MATRIX_SERVER_NAME=impro.chat
AUTH_PUBLIC_URL=https://auth.impro.chat

# Local/dev: SCHEME=http and CADDY_AUTO_HTTPS=off (no public DNS/certs required)
# Production: SCHEME=https and CADDY_AUTO_HTTPS=on
CADDY_AUTO_HTTPS=on
ACME_EMAIL=admin@impro.chat

# --- Postgres (superuser used only for init / admin) ---
POSTGRES_USER=impro_admin
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Per-service database passwords (least privilege)
IMPRO_DB_USER=impro_app
IMPRO_DB_PASSWORD=
IMPRO_DB_NAME=impro_app
SYNAPSE_DB_USER=synapse
SYNAPSE_DB_PASSWORD=
SYNAPSE_DB_NAME=synapse
MAS_DB_USER=mas
MAS_DB_PASSWORD=
MAS_DB_NAME=mas
MAUTRIX_WHATSAPP_DB_USER=mautrix_whatsapp
MAUTRIX_WHATSAPP_DB_PASSWORD=
MAUTRIX_WHATSAPP_DB_NAME=mautrix_whatsapp
MAUTRIX_TELEGRAM_DB_USER=mautrix_telegram
MAUTRIX_TELEGRAM_DB_PASSWORD=
MAUTRIX_TELEGRAM_DB_NAME=mautrix_telegram
MAUTRIX_SIGNAL_DB_USER=mautrix_signal
MAUTRIX_SIGNAL_DB_PASSWORD=
MAUTRIX_SIGNAL_DB_NAME=mautrix_signal
MAUTRIX_INSTAGRAM_DB_USER=mautrix_instagram
MAUTRIX_INSTAGRAM_DB_PASSWORD=
MAUTRIX_INSTAGRAM_DB_NAME=mautrix_instagram
MAUTRIX_MESSENGER_DB_USER=mautrix_messenger
MAUTRIX_MESSENGER_DB_PASSWORD=
MAUTRIX_MESSENGER_DB_NAME=mautrix_messenger
MAUTRIX_DISCORD_DB_USER=mautrix_discord
MAUTRIX_DISCORD_DB_PASSWORD=
MAUTRIX_DISCORD_DB_NAME=mautrix_discord

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Application secrets ---
APP_ENCRYPTION_KEY=
SESSION_SECRET=
DATABASE_URL=

# --- Synapse / MAS shared secret (must match on both sides) ---
MAS_MATRIX_SECRET=
SYNAPSE_MACAROON_SECRET=
SYNAPSE_REGISTRATION_SHARED_SECRET=
SYNAPSE_FORM_SECRET=

# --- MAS OAuth clients (ULIDs generated by bootstrap) ---
MAS_ISSUER=https://auth.impro.chat/
MAS_IMPRO_API_CLIENT_ID=
MAS_IMPRO_API_CLIENT_SECRET=
MAS_IMPRO_WEB_CLIENT_ID=
MAS_ENCRYPTION_KEY=

# --- Feature flags ---
FEATURE_BRIDGE_WHATSAPP=true
FEATURE_BRIDGE_TELEGRAM=true
FEATURE_BRIDGE_SIGNAL=true
FEATURE_BRIDGE_INSTAGRAM=true
FEATURE_BRIDGE_MESSENGER=true
FEATURE_BRIDGE_DISCORD=true
FEATURE_MATRIX_FEDERATION=true
FEATURE_WORKSPACE=true
FEATURE_AI=false
FEATURE_AUTOMATIONS=true
FEATURE_ANALYTICS=true
FEATURE_EXPERIMENTAL=false
FEATURE_MOCK_BRIDGE=false

# --- Bridges: credentials that must be supplied by the operator ---
# Telegram: https://my.telegram.org — leave empty to mark Telegram as "Setup required"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- SMTP (optional; without this, email verification is skipped / marked setup required) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Impro <noreply@impro.chat>"

# --- AI (optional OpenAI-compatible; default provider SpaceXAI) ---
AI_BASE_URL=https://api.spacexai.com/v1
AI_API_KEY=
AI_MODEL=grok-4

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info
NODE_ENV=production

# --- Media ---
MAX_UPLOAD_BYTES=52428800

# --- Optional first admin (leave username empty to skip auto-create) ---
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
